// Prisma schema for Canada Visa & Immigration website

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // hashed
  name      String
  role      String   @default("editor") // admin | editor
  createdAt DateTime @default(now())
}

// Generic content blocks for editable page sections (CMS)
model ContentBlock {
  id        String   @id @default(cuid())
  page      String // e.g. "home", "about", "contact"
  section   String // e.g. "hero", "stats", "cta"
  key       String // e.g. "title", "subtitle"
  valueEn   String
  valueFa   String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([page, section, key])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleEn     String
  titleFa     String
  shortDescEn String
  shortDescFa String
  descEn      String
  descFa      String
  icon        String   @default("file-text")
  durationEn  String   @default("")
  durationFa  String   @default("")
  feeFrom     String   @default("")
  order       Int      @default(0)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requirements ServiceRequirement[]
  steps       ServiceStep[]
}

model ServiceRequirement {
  id        String @id @default(cuid())
  serviceId String
  textEn    String
  textFa    String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceStep {
  id        String @id @default(cuid())
  serviceId String
  step      Int
  titleEn   String
  titleFa   String
  descEn    String
  descFa    String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameFa    String
  color     String   @default("red")
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleEn     String
  titleFa     String
  excerptEn   String
  excerptFa   String
  contentEn   String
  contentFa   String
  coverImage  String   @default("")
  type        String   @default("blog") // blog | news | guide
  categoryId  String?
  authorEn    String   @default("Maple Bridge Team")
  authorFa    String   @default("تیم میپل بریج")
  readingTime Int      @default(5)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  views       Int      @default(0)
  tagsEn      String   @default("")
  tagsFa      String   @default("")
  metaTitleEn String   @default("")
  metaTitleFa String   @default("")
  metaDescEn  String   @default("")
  metaDescFa  String   @default("")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([type, published, publishedAt])
}

model Testimonial {
  id        String   @id @default(cuid())
  nameEn    String
  nameFa    String
  countryEn String   @default("")
  countryFa String   @default("")
  programEn String   @default("")
  programFa String   @default("")
  textEn    String
  textFa    String
  rating    Int      @default(5)
  avatar    String   @default("")
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model TeamMember {
  id         String   @id @default(cuid())
  nameEn     String
  nameFa     String
  roleEn     String
  roleFa     String
  bioEn      String   @default("")
  bioFa      String   @default("")
  photo      String   @default("")
  linkedin   String   @default("")
  email      String   @default("")
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model ConsultationPackage {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameEn      String
  nameFa      String
  descEn      String
  descFa      String
  priceUSD    Int
  durationEn  String
  durationFa  String
  featuresEn  String // newline separated
  featuresFa  String
  popular     Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Booking {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String
  countryCode String   @default("+98")
  preferredLang String @default("fa")
  serviceSlug String   @default("general")
  packageSlug String   @default("")
  date        String
  timeSlot    String
  notes       String   @default("")
  status      String   @default("pending") // pending | confirmed | completed | cancelled
  amountUSD   Int      @default(0)
  paid        Boolean  @default(false)
  paymentRef  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model Assessment {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String
  age         Int
  educationEn String
  experienceYears Int
  ieltsScore  String   @default("")
  fieldEn     String   @default("")
  targetProgram String @default("express-entry")
  notes       String   @default("")
  score       Int      @default(0)
  eligibility String   @default("review")
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Faq {
  id      String @id @default(cuid())
  qEn     String
  qFa     String
  aEn     String
  aFa     String
  category String @default("general")
  order   Int    @default(0)
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
