# Database URL.
# - For local development: SQLite file (default).
# - For Vercel / production: use a real Postgres database
#   (Vercel Postgres, Neon, Supabase). Set this env var in your Vercel project
#   settings to the connection string, and switch the prisma provider to
#   "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Admin panel credentials (login at /#/admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="maple2025"
ADMIN_SESSION_TOKEN="mb-secret-token-2025"
